#include <WiFi.h>                   // Mbed‑basierte WLAN‑API

// WLAN‑Zugangsdaten
const char* ssid     = "FRITZ!Box 7590 CZ";
const char* password = "55593725082290737586";

// TCP‑Server auf Port 1234
WiFiServer server(1234);
WiFiClient client;

// I/O‑Pins
int forward1 = 43, backward1 = 41, forward2 = 39, backward2 = 37;
int speed1   = 3,  speed2    = 4;
int forward3 = 53, backward3 = 51, forward4 = 49, backward4 = 47;
int speed3   = 5,  speed4    = 6;
int ventiltransistor = 25;
int wifiled          = 45;

// Funktions‑Dispatcher
struct CommandHandler {
  const char* command;
  void (*handler)();
};

void handle1() {
  client.println("Handling 1");
  analogWrite(speed1, 255);
  analogWrite(speed2, 255);
  analogWrite(speed3, 255);
  analogWrite(speed4, 255);
  digitalWrite(backward1, LOW);
  digitalWrite(backward2, LOW);
  digitalWrite(forward1, HIGH);
  digitalWrite(forward2, HIGH);
  digitalWrite(backward3, LOW);
  digitalWrite(backward4, LOW);
  digitalWrite(forward3, HIGH);
  digitalWrite(forward4, HIGH);
}

void handle2() {
  client.println("Handling 2");
  analogWrite(speed1, 255);
  analogWrite(speed2, 255);
  analogWrite(speed3, 255);
  analogWrite(speed4, 255);
  digitalWrite(forward1, LOW);
  digitalWrite(forward2, LOW);
  digitalWrite(backward1, HIGH);
  digitalWrite(backward2, HIGH);
  digitalWrite(forward3, LOW);
  digitalWrite(forward4, LOW);
  digitalWrite(backward3, HIGH);
  digitalWrite(backward4, HIGH);
}

void handle3() {
  client.println("Handling 3");
  analogWrite(speed1, 0);
  analogWrite(speed2, 0);
  analogWrite(speed3, 0);
  analogWrite(speed4, 0);
  digitalWrite(backward1, LOW);
  digitalWrite(backward2, LOW);
  digitalWrite(forward1, LOW);
  digitalWrite(forward2, LOW);
  digitalWrite(backward3, LOW);
  digitalWrite(backward4, LOW);
  digitalWrite(forward3, LOW);
  digitalWrite(forward4, LOW);
}

void handle4() {
  client.println("Handling 4");
  digitalWrite(ventiltransistor, HIGH);
  delay(3000);
  digitalWrite(ventiltransistor, LOW);
}

CommandHandler commands[] = {
  {"1", handle1},
  {"2", handle2},
  {"3", handle3},
  {"4", handle4},
};

void handleCommand(const String &cmd) {
  for (auto &c : commands) {
    if (cmd.equals(c.command)) {
      c.handler();
      return;
    }
  }
  client.println("Unknown command");
}

void setup() {
  // Pins initialisieren
  for (int p : {forward1, backward1, forward2, backward2,
                forward3, backward3, forward4, backward4,
                speed1, speed2, speed3, speed4,
                ventiltransistor, wifiled}) {
    pinMode(p, OUTPUT);
  }

  Serial.begin(115200);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    WiFi.disconnect();
    Serial.println("WLAN Connect Versuch fehlgeschlagen");
    WiFi.begin(ssid, password);
    delay(2000);
  }
  Serial.println("\nConnected");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  server.begin();
}

void loop() {
  // LED an, wenn WLAN aktiv
  digitalWrite(wifiled, HIGH);

  // 1) Neue Clients annehmen, sobald sie Daten senden :contentReference[oaicite:0]{index=0}
  if (!client || !client.connected()) {
    WiFiClient newClient = server.available();
    if (newClient) {
      client = newClient;
      Serial.println("Client verbunden");
    }
  }

  // 2) Daten vom Client verarbeiten
  if (client && client.connected() && client.available()) {
    String cmd = client.readStringUntil('\n');  // Zeilenbasiert lesen
    cmd.trim();                                 // Whitespaces entfernen
    Serial.print("Received: ");
    Serial.println(cmd);
    client.print("Ack: ");
    client.println(cmd);
    handleCommand(cmd);
  }
  else if (!client || !client.connected()) {
    Serial.println("Kein Client verbunden");
    delay(500);
  }
}
