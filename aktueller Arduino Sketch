//DATA-Splitting
void parseCSV(String data) {
  int firstComma = data.indexOf(',');
  int secondComma = data.indexOf(',', firstComma + 1);
  int thirdComma = data.indexOf(',', secondComma + 1);
  int fourthComma = data.indexOf(',', thirdComma + 1);
  int fifthComma = data.indexOf(',', fourthComma + 1);
  int sixthComma = data.indexOf(',', fifthComma + 1);
  int seventhComma = data.indexOf(',', sixthComma + 1);
  int eighthComma = data.indexOf(',', seventhComma + 1);
  int ninthComma = data.indexOf(',', eighthComma + 1);
  int tenthComma = data.indexOf(',', ninthComma + 1);
  newmotor1 = data.substring(0, firstComma).toInt();
  newspeed1 = data.substring(firstComma + 1, secondComma).toInt();
  newmotor2 = data.substring(secondComma + 1, thirdComma).toInt();
  newspeed2 = data.substring(thirdComma + 1, fourthComma).toInt();
  newmotor3 = data.substring(fourthComma + 1, fifthComma).toInt();
  newspeed3 = data.substring(fifthComma + 1, sixthComma).toInt();
  newmotor4 = data.substring(sixthComma + 1, seventhComma).toInt();
  newspeed4 = data.substring(seventhComma + 1, eighthComma).toInt();
  newlenkservo = data.substring(eighthComma + 1, ninthComma).toInt();
  newturmservo = data.substring(ninthComma + 1, tenthComma).toInt();
  newlaufservo = data.substring(tenthComma + 1).toInt();
  Serial.print("lenkservo: "); Serial.println(newlenkservo);
  Serial.print("turmservo: "); Serial.println(newturmservo);
  Serial.print("laufservo: "); Serial.println(newlaufservo);
}

