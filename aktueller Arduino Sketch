// Wandelt Winkel in Pulsbreite 500–2500 µs um
int angleToPulse(int angle) {
  return map(angle, 0, 180, 500, 2500);
}
void writelenkservo(int angle) {
  int pw = angleToPulse(angle);
  for (int i = 0; i < 50; ++i) {          // 50 × 20 ms = 1 s Fahrtzeit
    digitalWrite(lenkservopin, HIGH);
    delayMicroseconds(pw);
    digitalWrite(lenkservopin, LOW);
    delayMicroseconds(20000 - pw);
  }
}
void writeturmservo(int angle) {
  int pw = angleToPulse(angle);
  for (int i = 0; i < 50; ++i) {          // 50 × 20 ms = 1 s Fahrtzeit
    digitalWrite(turmservopin, HIGH);
    delayMicroseconds(pw);
    digitalWrite(turmservopin, LOW);
    delayMicroseconds(20000 - pw);
  }
}
void writelaufservo(int angle) {
  int pw = angleToPulse(angle);
