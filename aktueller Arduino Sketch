void setup() {
  Serial.begin(115200);
  //WIFI
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    WiFi.disconnect();
    Serial.println("WLAN Connect Versuch fehlgeschlagen");
    WiFi.begin(ssid, password);
    delay(2000);
  }
  Serial.println("WLAN verbunden!");
  Serial.print("IP-Adresse: ");
  Serial.println(WiFi.localIP());
  server1.begin(); // HTTP-Server starten
  server2.begin(); // TCP-Server starten
  //Variablen
  motor1 = 0;
  speed1 = 0;
  motor2 = 0;
  speed2 = 0;
  motor3 = 0;
  speed3 = 0;
  motor4 = 0;
  speed4 = 0;
  lenkservo= 0;
  turmservo= 0;
  laufservo= 0;
  pinMode(lenkservopin, OUTPUT);
  pinMode(turmservopin, OUTPUT);
  pinMode(laufservopin, OUTPUT);
}

void loop() {
  // 1. HTTP-Server: Java holt Messwerte
  client1 = server1.available();
  if (client1) {
    String req = client1.readStringUntil('\r');
    client1.flush();

    if (req.indexOf("GET /messwerte") >= 0) {
      // Richtige Anfrage: Messwerte liefern
      String response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\n";
      response += "150,180,0,180";  // Beispielwerte (CSV)
      client1.print(response);
    } else {
      // Andere Anfrage: 404
      String response = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\n\r\n";
      response += "Pfad nicht gefunden";
      client1.print(response);
    }
    client1.stop();
  }

  // 2. TCP-Server: Java sendet Befehle
  if (!client2 || !client2.connected()) {
    client2 = server2.available();
  }
  if (client2 && client2.connected()) {
    if (client2.available()) {
      String command = client2.readStringUntil('\n');
      command.trim();
      parseCSV(command);
      checknewData();
      Serial.print("Fertig");
    }
  }
}
